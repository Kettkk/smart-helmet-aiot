# Local development only. Copy this file to .env; never commit .env.
MYSQL_DATABASE=smart_helmet
MYSQL_USER=smart_helmet
MYSQL_PASSWORD=local-development-only
MYSQL_ROOT_PASSWORD=local-root-only

BACKEND_PORT=8080
MQTT_PORT=1883
MQTT_TOPIC=smart-helmet/telemetry

SIMULATOR_DEVICE_ID=helmet-sim-001
SIMULATOR_INTERVAL_SECONDS=1
SIMULATOR_RANDOM_SEED=42
